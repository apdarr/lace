<div class="max-w-4xl mx-auto px-4">
  <% if alert = flash[:alert] %>
    <p class="mb-4 inline-flex items-center rounded-md bg-red-50 px-3 py-2 text-sm font-medium text-red-700 ring-1 ring-inset ring-red-200" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="mb-4 inline-flex items-center rounded-md bg-green-50 px-3 py-2 text-sm font-medium text-green-700 ring-1 ring-inset ring-green-200" id="notice"><%= notice %></p>
  <% end %>

  <div class="space-y-8">
    <header class="text-center mt-12">
      <h1 class="heading-page mb-3">Welcome to Lace</h1>
      <p class="text-lg text-slate-600 font-medium">Your training companion for your next race</p>
    </header>

    <section class="card">
      <div class="card-section space-y-6">
        <h2 class="heading-section text-center">Follow your favorite training plan, with superpowers 🍄</h2>
        
        <div class="grid md:grid-cols-2 gap-4">
          <div class="flex items-start gap-3 p-4 rounded-lg border border-slate-200 bg-slate-50/50 transition-all hover:border-blue-300 hover:bg-blue-50/50 hover:shadow-sm">
            <span class="text-2xl flex-shrink-0">🔍</span>
            <div class="text-left">
              <p class="text-sm font-semibold text-slate-800 mb-1">Scan your training plan</p>
              <p class="text-xs text-slate-600">Many runners have a favorite training plan from a book, website, etc. Upload photos or screenshots of your training plan, choose your race date, and Lace will let AI automatically schedule your workouts</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3 p-4 rounded-lg border border-slate-200 bg-slate-50/50 transition-all hover:border-blue-300 hover:bg-blue-50/50 hover:shadow-sm">
            <span class="text-2xl flex-shrink-0">🛤️</span>
            <div class="text-left">
              <p class="text-sm font-semibold text-slate-800 mb-1">Make easy adjustments</p>
              <p class="text-xs text-slate-600">Drag and drop workouts to adjust your schedule as life happens</p>
            </div>
          </div>

          <div class="flex items-start gap-3 p-4 rounded-lg border border-slate-200 bg-slate-50/50 transition-all hover:border-blue-300 hover:bg-blue-50/50 hover:shadow-sm">
            <span class="text-2xl flex-shrink-0">📎</span>
            <div class="text-left">
              <p class="text-sm font-semibold text-slate-800 mb-1">Strava integration</p>
              <p class="text-xs text-slate-600">Match completed Strava activities to your workouts, so you can easily cross-reference activities</p>
            </div>
          </div>
          
          <div class="flex items-start gap-3 p-4 rounded-lg border border-slate-200 bg-slate-50/50 transition-all hover:border-blue-300 hover:bg-blue-50/50 hover:shadow-sm">
            <span class="text-2xl flex-shrink-0">📱</span>
            <div class="text-left">
              <p class="text-sm font-semibold text-slate-800 mb-1">Mobile support</p>
              <p class="text-xs text-slate-600">Receive a notification the night before each workout so you're ahead of schedule</p>
            </div>
          </div>

          <div class="flex items-start gap-3 p-4 rounded-lg border border-slate-200 bg-slate-50/50 transition-all hover:border-blue-300 hover:bg-blue-50/50 hover:shadow-sm">
            <span class="text-2xl flex-shrink-0">📅</span>
            <div class="text-left">
              <p class="text-sm font-semibold text-slate-800 mb-1">Google Calendar integration</p>
              <p class="text-xs text-slate-600">Sync your training plan to a shared Google Calendar so friends and family know when you're headed out</p>
            </div>
          </div>
        </div>
      </div>

      <div class="divider mx-4"></div>

      <div class="card-section">
        <h3 class="font-semibold text-lg text-center text-slate-800 mb-4">Ready to start training?</h3>
        
        <%= button_to "/auth/strava", method: :post, data: { turbo: false }, class: "rounded-lg py-4 px-5 bg-[#FC4C02] text-white font-semibold cursor-pointer w-full flex items-center justify-center gap-3 hover:bg-[#e64500] transition-all shadow-sm hover:shadow-md" do %>
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7.01 13.828h4.172"/>
          </svg>
          Continue with Strava
        <% end %>

        <div class="relative my-4">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-slate-200"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="bg-white px-3 text-slate-500">or</span>
          </div>
        </div>

        <%= button_to "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "rounded-lg py-4 px-5 bg-white text-slate-700 font-semibold cursor-pointer w-full flex items-center justify-center gap-3 hover:bg-slate-50 transition-all shadow-sm hover:shadow-md border border-slate-300" do %>
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Continue with Google
        <% end %>
      </div>
    </section>
  </div>
</div>
